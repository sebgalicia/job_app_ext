{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Job Autofill answers",
  "type": "object", "additionalProperties": false,
  "required": ["profile", "facts", "answers"],
  "properties": {
    "_instructions": { "type": "string", "description": "Edit this file, then import it in Job Autofill settings." },
    "profile": {
      "type": "object", "additionalProperties": { "type": ["string", "number"] },
      "properties": {
        "firstName": { "type": "string" }, "middleName": { "type": "string" }, "lastName": { "type": "string" }, "preferredName": { "type": "string" },
        "email": { "type": "string" }, "phone": { "type": "string" }, "phoneDeviceType": { "type": "string" }, "pronouns": { "type": "string" },
        "address": { "type": "string" }, "addressLine2": { "type": "string" }, "city": { "type": "string" }, "state": { "type": "string" }, "zip": { "type": "string" }, "country": { "type": "string" }, "currentLocation": { "type": "string" },
        "linkedin": { "type": "string" }, "github": { "type": "string" }, "website": { "type": "string" }, "portfolio": { "type": "string" },
        "school": { "type": "string" }, "schoolCity": { "type": "string" }, "schoolCountry": { "type": "string" }, "degree": { "type": "string" }, "degreeReceived": { "type": "string" },
        "major": { "type": "string" }, "minor": { "type": "string" }, "gpa": { "type": ["string", "number"] }, "gpaScale": { "type": "string" },
        "schoolStartDate": { "type": "string" }, "schoolEndDate": { "type": "string" },
        "schoolStartDateMonth": { "type": "string" }, "schoolStartDateYear": { "type": ["string", "number"] },
        "schoolEndDateMonth": { "type": "string" }, "schoolEndDateYear": { "type": ["string", "number"] }, "gradYear": { "type": ["string", "number"] },
        "currentCompany": { "type": "string" }, "currentTitle": { "type": "string" }, "yearsExperience": { "type": ["string", "number"] },
        "employmentStartDate": { "type": "string" }, "employmentEndDate": { "type": "string" }, "employmentDescription": { "type": "string" },
        "availableStartDate": { "type": "string" }, "noticePeriod": { "type": "string" }, "preferredWorkLocation": { "type": "string" },
        "skills": { "type": "string" }, "certifications": { "type": "string" }, "languages": { "type": "string" }, "references": { "type": "string" }, "professionalSummary": { "type": "string" }
      }
    },
    "profileAlternates": {
      "type": "object",
      "description": "Equivalent labels for profile values, used when matching offered choices. Keys are profile field names.",
      "additionalProperties": { "$ref": "#/$defs/alternates" },
      "properties": {
        "firstName": { "$ref": "#/$defs/alternates" }, "lastName": { "$ref": "#/$defs/alternates" },
        "email": { "$ref": "#/$defs/alternates" }, "phone": { "$ref": "#/$defs/alternates" },
        "address": { "$ref": "#/$defs/alternates" }, "city": { "$ref": "#/$defs/alternates" },
        "state": { "$ref": "#/$defs/alternates" }, "zip": { "$ref": "#/$defs/alternates" },
        "country": { "$ref": "#/$defs/alternates" }, "linkedin": { "$ref": "#/$defs/alternates" },
        "github": { "$ref": "#/$defs/alternates" }, "website": { "$ref": "#/$defs/alternates" },
        "school": { "$ref": "#/$defs/alternates" }, "degree": { "$ref": "#/$defs/alternates" },
        "major": { "$ref": "#/$defs/alternates" }, "gradYear": { "$ref": "#/$defs/alternates" },
        "middleName": { "$ref": "#/$defs/alternates" }, "phoneDeviceType": { "$ref": "#/$defs/alternates" }, "preferredName": { "$ref": "#/$defs/alternates" },
        "pronouns": { "$ref": "#/$defs/alternates" }, "addressLine2": { "$ref": "#/$defs/alternates" },
        "currentLocation": { "$ref": "#/$defs/alternates" }, "portfolio": { "$ref": "#/$defs/alternates" },
        "schoolCity": { "$ref": "#/$defs/alternates" }, "schoolCountry": { "$ref": "#/$defs/alternates" },
        "degreeReceived": { "$ref": "#/$defs/alternates" }, "minor": { "$ref": "#/$defs/alternates" },
        "gpa": { "$ref": "#/$defs/alternates" }, "gpaScale": { "$ref": "#/$defs/alternates" },
        "schoolStartDate": { "$ref": "#/$defs/alternates" }, "schoolEndDate": { "$ref": "#/$defs/alternates" },
        "schoolStartDateMonth": { "$ref": "#/$defs/alternates" }, "schoolStartDateYear": { "$ref": "#/$defs/alternates" },
        "schoolEndDateMonth": { "$ref": "#/$defs/alternates" }, "schoolEndDateYear": { "$ref": "#/$defs/alternates" },
        "currentCompany": { "$ref": "#/$defs/alternates" }, "currentTitle": { "$ref": "#/$defs/alternates" },
        "yearsExperience": { "$ref": "#/$defs/alternates" }, "employmentStartDate": { "$ref": "#/$defs/alternates" },
        "employmentEndDate": { "$ref": "#/$defs/alternates" }, "employmentDescription": { "$ref": "#/$defs/alternates" },
        "availableStartDate": { "$ref": "#/$defs/alternates" }, "noticePeriod": { "$ref": "#/$defs/alternates" },
        "preferredWorkLocation": { "$ref": "#/$defs/alternates" }, "skills": { "$ref": "#/$defs/alternates" },
        "certifications": { "$ref": "#/$defs/alternates" }, "languages": { "$ref": "#/$defs/alternates" },
        "references": { "$ref": "#/$defs/alternates" }, "professionalSummary": { "$ref": "#/$defs/alternates" }
      }
    },
    "profileQuestions": {
      "type": "object",
      "description": "Optional question labels for built-in or custom profile fields. Add a key matching the profile field name and one or more labels used by application forms.",
      "additionalProperties": { "$ref": "#/$defs/alternates" }
    },
    "facts": { "type": "object", "description": "Common yes/no facts, including conflictOfInterest (true means you have a conflict; false means you do not), plus optional salary or other answers.", "additionalProperties": { "type": ["string", "number", "boolean"] } },
    "answers": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["questions", "type", "answer"], "properties": {
      "questions": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "type": { "enum": ["text", "choice", "yesno"] },
      "answer": { "type": ["string", "boolean"] }, "sensitive": { "type": "boolean" }
    } } }
  },
  "$defs": {
    "alternates": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
