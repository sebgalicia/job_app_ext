{
  "manifest_version": 3,
  "name": "Job Autofill",
  "version": "0.1.0",
  "description": "Private, rules-based previews for your saved job application answers.",
  "permissions": ["storage", "activeTab"],
  "optional_permissions": ["scripting"],
  "action": { "default_title": "Job Autofill", "default_popup": "popup.html" },
  "options_ui": { "page": "settings.html", "open_in_tab": true },
  "background": { "scripts": ["background.js"] },
  "content_scripts": [{
    "matches": ["*://*.myworkdayjobs.com/*", "*://*.myworkday.com/*", "*://boards.greenhouse.io/*", "*://job-boards.greenhouse.io/*", "*://jobs.lever.co/*", "*://jobs.ashbyhq.com/*"],
    "js": ["content.js"], "all_frames": true, "run_at": "document_idle"
  }],
  "browser_specific_settings": { "gecko": { "id": "@job-autofill", "strict_min_version": "140.0", "data_collection_permissions": { "required": ["none"] } }
  }
}
